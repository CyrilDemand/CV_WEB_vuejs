{
  "name": "cv-web-vuejs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "deploy": "bun run build && aws s3 sync ./dist s3://cyrildemand-cv-web --delete --exclude '*.js' && aws s3 cp ./dist/ s3://cyrildemand-cv-web/ --recursive --exclude '*' --include '*.js' --content-type 'application/javascript'"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.0.15",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.21.0",
    "eslint-plugin-vue": "~10.0.0",
    "globals": "^16.0.0",
    "postcss": "^8.5.3",
    "prettier": "3.5.3",
    "tailwindcss": "^4.0.15",
    "vite": "^6.2.1",
    "vite-plugin-vue-devtools": "^7.7.2"
  }
}
